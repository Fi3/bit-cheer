# Editor defaults that agree with the formatters (Prettier, elm-format, rustfmt).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{elm,rs,py}]
indent_size = 4

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false
